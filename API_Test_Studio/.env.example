# =============================================================================
# API Test Studio — Backend Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
#
# Usage with Docker:
#   docker run --env-file .env -p 8000:8000 api-test-studio-backend
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# Host the uvicorn server binds to.
# Must be 0.0.0.0 inside Docker so the port is reachable from the host.
BACKEND_HOST=0.0.0.0

# Port uvicorn listens on (must match the -p mapping in docker run).
BACKEND_PORT=8000

# Enable hot-reload (development only — never true in production).
BACKEND_RELOAD=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Uvicorn / application log level: debug | info | warning | error | critical
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Add your frontend origin here (e.g. http://localhost:5173 for Vite dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Active environment ────────────────────────────────────────────────────────
# Must match a key in configs/environments.yaml.
# Determines base_url, auth_type, and headers used for test execution.
API_ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Absolute path to the SQLite database file inside the container.
# Override this when mounting a host-side volume for persistence.
# Example: DATABASE_PATH=/data/api_test_studio.db
DATABASE_PATH=/app/database/api_test_studio.db

# ── Directories ───────────────────────────────────────────────────────────────
# These paths are inside the container. Mount host directories over them
# with -v to persist data between container restarts.
REPORTS_DIR=/app/reports
HISTORY_DIR=/app/history
UPLOADED_SPECS_DIR=/app/uploaded_specs
