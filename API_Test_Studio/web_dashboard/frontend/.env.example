# =============================================================================
# API Test Studio — Frontend Environment Variables
# =============================================================================
# Vite reads variables prefixed with VITE_ at BUILD TIME and inlines them
# into the JavaScript bundle.  They are NOT available as runtime env vars
# inside the container — they must be provided as --build-arg values when
# running "docker build".
#
# Usage:
#   docker build \
#     --build-arg VITE_API_BASE_URL=http://your-backend:8000 \
#     --build-arg VITE_APP_NAME="API Test Studio" \
#     -t api-test-studio-frontend .
#
# For local development (Vite dev server):
#   Copy this file to .env and fill in values.
#   Vite will read .env automatically.
# =============================================================================

# ── Backend API base URL ──────────────────────────────────────────────────────
# The origin (scheme + host + port) of the FastAPI backend.
# Leave empty during development — the Vite dev server proxy handles /api/*.
# In production Docker, set this to the backend container or load-balancer URL.
#
# Examples:
#   http://localhost:8000          (backend on same host, different port)
#   http://backend:8000            (Docker Compose service name)
#   https://api.your-company.com   (production reverse proxy)
VITE_API_BASE_URL=

# ── Application metadata (displayed in the UI) ────────────────────────────────
VITE_APP_NAME=API Test Studio
VITE_APP_VERSION=1.0.0
