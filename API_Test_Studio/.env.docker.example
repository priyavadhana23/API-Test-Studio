# =============================================================================
# API Test Studio — Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env before running "docker compose up".
#
#   cp .env.docker.example .env
#   docker compose up --build
#
# Values set here override the defaults defined in docker-compose.yml.
# NEVER commit a .env file containing real secrets to version control.
# =============================================================================

# ── Port mapping ──────────────────────────────────────────────────────────────
# The host port the FastAPI backend is published on.
# Access the API at:  http://localhost:<BACKEND_PORT>/api/health
BACKEND_PORT=8000

# The host port the Nginx frontend is published on.
# Open the dashboard at:  http://localhost:<FRONTEND_PORT>
FRONTEND_PORT=80

# ── Backend server ────────────────────────────────────────────────────────────
# Log verbosity: debug | info | warning | error | critical
LOG_LEVEL=info

# Active test environment (must match a key in configs/environments.yaml).
# Controls the base_url, auth_type, and headers used during test execution.
API_ENVIRONMENT=development

# ── Frontend build arguments ──────────────────────────────────────────────────
# These are baked into the JS bundle at "docker compose build" time.
# VITE_API_BASE_URL: leave empty — Nginx proxies /api/* to the backend
# container using the Docker service name (http://backend:8000) internally.
# Set this only if you are exposing the backend on a public URL and want
# the browser to call it directly (bypassing Nginx).
VITE_API_BASE_URL=
VITE_APP_NAME=API Test Studio
VITE_APP_VERSION=1.0.0

# ── Volume paths (informational only — managed by Docker) ─────────────────────
# These named volumes are created automatically by Docker Compose.
# To inspect them:  docker volume ls | grep ats-
# To wipe all data: docker compose down -v   ← DESTRUCTIVE
#
# ats-database       → /app/database   (SQLite .db file)
# ats-uploaded-specs → /app/uploaded_specs  (spec files)
# ats-reports        → /app/reports    (HTML, PDF, CSV, JSON reports)
# ats-history        → /app/history    (run export files)
# ats-logs           → /app/logs       (application logs)
